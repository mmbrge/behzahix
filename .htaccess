# Apache (cPanel / DirectAdmin) settings for the static BEHIX site.
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (uncomment after the SSL certificate is active in cPanel)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # One host only: send www to the bare domain (or swap to prefer www)
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Short links: /s/CODE → link shortener redirect
  RewriteRule ^s/([A-Za-z0-9_-]+)/?$ api/index.php?r=go&c=$1 [L,QSA]
  # Studio hosted pages: /c/NAME → digital business card or QR menu
  RewriteRule ^c/([A-Za-z0-9-]+)/?$ p.php?s=$1 [L,QSA]

  # SEO: sitemap, robots and every public page go through seo.php
  # (adds title/description/canonical/Open Graph/JSON-LD and server-rendered content)
  RewriteRule ^sitemap\.xml$ seo.php?sitemap=1 [L]
  RewriteRule ^robots\.txt$ seo.php?robots=1 [L]
  RewriteRule ^$ seo.php?page=index [L,QSA]
  RewriteRule ^(index|services|service|order|portfolio|shop|designers|about|terms|tools|blog|studio)\.html$ seo.php?page=$1 [L,QSA]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/rss+xml application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Never serve backups, logs, dotfiles or dependency folders
<FilesMatch "(^\.|\.(sql|gz|log|bak|old|env|ini|lock|md|dist|sh)$|^composer\.(json|lock)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^(vendor|api/vendor|api/lib|api/fonts)(/|$) - [F,L]
</IfModule>

AddType application/manifest+json .webmanifest

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 day"
  # Pages load CSS/JS as file.css?v=… — bump the version in the HTML after
  # changing them so returning visitors get the new files.
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
